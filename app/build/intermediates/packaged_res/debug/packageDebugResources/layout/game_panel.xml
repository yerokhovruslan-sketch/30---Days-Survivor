<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_panel" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0E0E0E" android:padding="16dp"
    android:visibility="gone" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/panel_world_clock" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:textColor="#BDBDBD" android:textSize="13sp"
        android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground"/>
    <TextView android:id="@+id/section_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#D6D6D6" android:textSize="24sp" android:textStyle="bold"/>
    <TextView android:id="@+id/section_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#A7A7A7" android:textSize="14sp" android:layout_marginTop="4dp" android:layout_marginBottom="12dp"/>
    <LinearLayout android:id="@+id/tactical_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false" android:visibility="gone" android:layout_marginBottom="8dp" />
    <ScrollView android:id="@+id/section_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/status_slot" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp" android:background="@drawable/status_panel" android:layout_marginBottom="14dp"/>
            <LinearLayout android:id="@+id/event_card" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp" android:background="@drawable/information_panel" android:layout_marginBottom="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/events_label"
                    android:textColor="#B2B2B2" android:textSize="12sp" android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/section_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#D1D1D1" android:textSize="15sp" android:lineSpacingExtra="4dp" android:textIsSelectable="true"/>
                <TextView android:id="@+id/event_toggle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:gravity="center_vertical" android:textColor="#C1C1C1" android:textSize="14sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/menu_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <TextView android:id="@+id/choice_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/actions_label" android:textColor="#B2B2B2" android:textSize="12sp" android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
            <LinearLayout android:id="@+id/section_choices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <LinearLayout android:id="@+id/quantity_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp" android:background="@drawable/status_panel" android:layout_marginBottom="12dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/footer_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="vertical"/>
</LinearLayout>
