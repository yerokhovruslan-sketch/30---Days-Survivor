<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0E0E0E">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/game_title" android:textColor="#D1D1D1" android:textSize="48sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.03" android:layout_marginTop="12dp" />

    <TextView android:layout_width="match_parent" android:layout_height="41dp" android:layout_marginBottom="24dp" android:text="Ты тут один" android:textColor="#A7A7A7" android:textSize="12sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/status_panel" android:padding="16dp" android:layout_marginBottom="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/character_name" android:textSize="26sp" android:textStyle="bold" android:textColor="#D6D6D6" />
<TextView style="@style/StatLabel" android:id="@+id/character_day" android:text="@string/day" />
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/character_balance" android:text="@string/balance" android:textColor="#B5B5B5" android:textSize="16sp" />
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#444444" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="10dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
<TextView style="@style/StatLabel" android:text="@string/stamina" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ProgressBar android:id="@+id/stat_stamina" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:max="100" android:progress="100" android:progressTint="@color/stat_stamina_color" android:progressBackgroundTint="#414141" android:importantForAccessibility="no" />
<TextView android:id="@+id/value_stamina" android:layout_width="62dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/full_value" android:textColor="#D1D1D1" android:textSize="12sp" />
</LinearLayout></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
<TextView style="@style/StatLabel" android:text="@string/hunger" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ProgressBar android:id="@+id/stat_hunger" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:max="100" android:progress="0" android:progressTint="@color/stat_hunger_color" android:progressBackgroundTint="#414141" android:importantForAccessibility="no" />
<TextView android:id="@+id/value_hunger" android:layout_width="62dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/empty_value" android:textColor="#D1D1D1" android:textSize="12sp" />
</LinearLayout></LinearLayout></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
<TextView style="@style/StatLabel" android:text="@string/sleepiness" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ProgressBar android:id="@+id/stat_sleepiness" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:max="100" android:progress="0" android:progressTint="#959595" android:progressBackgroundTint="#414141" android:importantForAccessibility="no" />
<TextView android:id="@+id/value_sleepiness" android:layout_width="62dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/empty_value" android:textColor="#D1D1D1" android:textSize="12sp" />
</LinearLayout></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
<TextView style="@style/StatLabel" android:text="@string/noise" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ProgressBar android:id="@+id/stat_noise" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:max="100" android:progress="0" android:progressTint="#9A9A9A" android:progressBackgroundTint="#414141" android:importantForAccessibility="no" />
<TextView android:id="@+id/value_noise" android:layout_width="62dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/empty_value" android:textColor="#D1D1D1" android:textSize="12sp" />
</LinearLayout></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
<TextView style="@style/StatLabel" android:text="@string/temperature" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ProgressBar android:id="@+id/stat_temperature" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:max="100" android:progress="0" android:progressTint="#9A9A9A" android:progressBackgroundTint="#414141" android:importantForAccessibility="no" />
<TextView android:id="@+id/value_temperature" android:layout_width="62dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/temperature_value" android:textColor="#D1D1D1" android:textSize="12sp" />
</LinearLayout></LinearLayout></LinearLayout>
</LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="fill_vertical"><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_status" android:drawableStart="@drawable/menu_symbol_character" style="@style/MenuGridButton" android:text="@string/menu_status" app:backgroundTint="@null" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_explore" android:drawableStart="@drawable/menu_symbol_expedition" style="@style/MenuGridButton" android:text="@string/menu_explore" app:backgroundTint="@null" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="fill_vertical"><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_inventory" android:drawableStart="@drawable/menu_symbol_inventory" style="@style/MenuGridButton" android:text="@string/menu_inventory" app:backgroundTint="@null" />

    <androidx.appcompat.widget.AppCompatButton android:id="@+id/action_shop" style="@style/MenuGridButton" android:drawableStart="@drawable/menu_symbol_shop" android:scrollbarFadeDuration="250" android:text="@string/menu_shop" app:backgroundTint="@null" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="fill_vertical"><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_heal" android:drawableStart="@drawable/menu_symbol_healing" style="@style/MenuGridButton" android:text="@string/menu_heal" app:backgroundTint="@null" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_equipment" android:drawableStart="@drawable/menu_symbol_equipment" style="@style/MenuGridButton" android:text="@string/menu_equipment" app:backgroundTint="@null" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="fill_vertical"><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_rest" android:drawableStart="@drawable/menu_symbol_rest" style="@style/MenuGridButton" android:text="@string/menu_rest" app:backgroundTint="@null" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_notes" android:drawableStart="@drawable/menu_symbol_notes" style="@style/MenuGridButton" android:text="@string/menu_notes" app:backgroundTint="@null" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="fill_vertical"><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_eat" android:drawableStart="@drawable/menu_symbol_eat" style="@style/MenuGridButton" android:text="@string/menu_eat" app:backgroundTint="@null" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_sleep" android:drawableStart="@drawable/menu_symbol_sleep" style="@style/MenuGridButton" android:text="@string/menu_sleep" app:backgroundTint="@null" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="fill_vertical"><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_save" android:drawableStart="@drawable/menu_symbol_save" style="@style/MenuGridButton" android:text="@string/menu_save" app:backgroundTint="@null" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_load" android:drawableStart="@drawable/menu_symbol_load" style="@style/MenuGridButton" android:text="@string/menu_load" app:backgroundTint="@null" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="fill_vertical"><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_unload" android:drawableStart="@drawable/menu_symbol_unload_backpack" style="@style/MenuGridButton" android:text="@string/menu_unload" app:backgroundTint="@null" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_repair" android:drawableStart="@drawable/menu_symbol_repair" style="@style/MenuGridButton" android:text="@string/menu_repair" app:backgroundTint="@null" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="fill_vertical"><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_armor" android:drawableStart="@drawable/menu_symbol_armor" style="@style/MenuGridButton" android:text="@string/menu_armor" app:backgroundTint="@null" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/action_journal" android:drawableStart="@drawable/menu_symbol_journal" style="@style/MenuGridButton" android:text="@string/menu_journal" app:backgroundTint="@null" /></LinearLayout>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/action_shelter" style="@style/MenuButton" android:layout_width="match_parent" android:layout_weight="0" android:drawableStart="@drawable/menu_symbol_inventory" android:text="@string/menu_shelter" app:backgroundTint="@null" />
<androidx.appcompat.widget.AppCompatButton android:id="@+id/action_exit" android:gravity="center" style="@style/MenuButton" android:layout_width="match_parent" android:layout_weight="0" android:layout_marginTop="12dp" android:background="@drawable/exit_button" android:text="@string/menu_exit" app:backgroundTint="@null" />
</LinearLayout></ScrollView><include layout="@layout/game_panel" /><include layout="@layout/intro_screen" /><include layout="@layout/radio_screen" /></FrameLayout>
