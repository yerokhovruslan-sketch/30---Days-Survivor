<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radio_screen" android:layout_width="match_parent" android:layout_height="match_parent"
    android:visibility="gone" android:background="#000000" android:clickable="true" android:focusable="true">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginBottom="104dp" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="28dp">
            <TextView android:id="@+id/radio_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textSize="30sp" android:textColor="#EEEEEE" android:textStyle="bold" />
            <TextView android:id="@+id/radio_body" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:gravity="center" android:fontFamily="monospace"
                android:textSize="18sp" android:textColor="#C6C6C6" android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/radio_continue" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="24dp" android:minHeight="52dp"
        android:visibility="invisible" android:enabled="false" android:text="@string/intro_continue"
        android:textAllCaps="false" android:textColor="#EEEEEE" android:backgroundTint="#252525" />
</FrameLayout>
