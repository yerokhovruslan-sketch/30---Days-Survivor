<resources>
<style name="MenuButton" parent="Widget.AppCompat.Button">
<item name="android:layout_width">0dp</item>
<item name="android:layout_height">wrap_content</item>
<item name="android:layout_weight">1</item>
<item name="android:minHeight">80dp</item>
<item name="android:drawablePadding">8dp</item>
<item name="android:layout_margin">4dp</item>
<item name="android:background">@drawable/menu_button</item>
<item name="backgroundTint">@null</item>
<item name="android:padding">12dp</item>
<item name="android:textColor">#D6D6D6</item>
<item name="android:textSize">16sp</item>
<item name="android:fontFamily">sans-serif-condensed</item>
<item name="android:textAllCaps">false</item>
<item name="android:gravity">start|center_vertical</item>
</style>
<style name="MenuGridButton" parent="MenuButton">
<item name="android:layout_height">match_parent</item>
<item name="android:layout_gravity">fill_vertical</item>
</style>
<style name="StatLabel">
<item name="android:layout_width">match_parent</item>
<item name="android:layout_height">wrap_content</item>
<item name="android:textColor">#C6C6C6</item>
<item name="android:textSize">13sp</item>
<item name="android:fontFamily">sans-serif-condensed</item>
</style>
</resources>
